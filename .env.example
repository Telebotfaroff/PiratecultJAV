# PiratecultJAV Environment Configuration
# Required production variables per Project Guide Section 5

# Telegram Bot Token from @BotFather (primary)
BOT_TOKEN=

# Optional recovery bot token. Add this bot to the same dump/force-sub channels.
BACKUP_BOT_TOKEN=

# Which bot to prefer on startup: primary or backup. If primary fails, backup is selected automatically.
ACTIVE_BOT=primary

# Supabase PostgreSQL credentials (server-side secret key; never expose to client)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram Dump Channel ID (actual media storage layer)
DUMP_CHAT_ID=-1004426377644

# Comma-separated Telegram User IDs with admin access
ADMIN_IDS=

# Javtiful Metadata Provider Base URL
JAVTIFUL_BASE_URL=https://javtiful.com

# Server Port (default 3000 in AI Studio, 10000 in production host)
PORT=3000

# Required for dashboard/admin API authentication
ADMIN_API_KEY=change-this-to-a-long-random-secret
